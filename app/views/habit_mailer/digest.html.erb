<div style="font-family:Inter,Arial,sans-serif;max-width:560px;margin:0 auto;padding:24px">
  <h1 style="font-size:22px">📊 Your week in Momentum</h1>
  <p style="color:#475569">Hi <%= @user.display_name %>, here’s how you did:</p>
  <ul>
    <% @habits.each do |h| %>
      <li><strong><%= h.title %></strong> — <%= h.streak %>-day streak, <%= h.completion_rate(days: 7) %>% this week</li>
    <% end %>
  </ul>
  <p><a href="<%= root_url %>" style="display:inline-block;background:#1B1031;color:#fff;padding:10px 18px;border-radius:10px;text-decoration:none;font-weight:600">Keep the momentum</a></p>
</div>
