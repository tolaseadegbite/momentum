<% content_for :title, "Create account — Momentum" %>
<div class="min-h-screen grid lg:grid-cols-2">
  <div class="hidden lg:flex flex-col justify-between p-12 bg-[#1B1031] text-[#FAF7F2] relative overflow-hidden">
    <div class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-[#C4712A]/20 blur-3xl"></div>
    <a href="/" class="relative flex items-center gap-2.5"><span class="w-9 h-9 rounded-xl bg-white/10 grid place-items-center font-extrabold text-[#E8BCB9]">◍</span><span class="font-extrabold text-lg font-display">Momentum</span></a>
    <div class="relative">
      <h1 class="font-display text-4xl font-bold tracking-tight leading-tight">Start small.<br>Stay consistent.</h1>
      <p class="text-[#E8BCB9]/80 mt-4 max-w-sm">Join Momentum — create habits in seconds, check in with one tap, and watch your streaks grow.</p>
      <ul class="mt-6 space-y-2 text-sm text-[#E8BCB9]/70">
        <li>✓ One-tap daily check-ins</li>
        <li>✓ GitHub-style heatmaps</li>
        <li>✓ Mood journal + reminders</li>
      </ul>
    </div>
    <p class="relative text-xs text-[#E8BCB9]/60">Free forever for your first habits • No credit card</p>
  </div>
  <div class="flex items-center justify-center p-6 sm:p-12 bg-white">
    <div class="w-full max-w-md">
      <h2 class="font-display text-2xl font-bold tracking-tight">Create your account ✨</h2>
      <p class="text-sm text-stone-500 mt-1">Already have one? <%= link_to "Sign in", new_session_path, class: "font-bold text-[#A85A1D]" %></p>
      <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |f| %>
        <% if @user.errors.any? %>
          <div class="rounded-xl bg-rose-50 text-rose-700 text-sm p-3 ring-1 ring-rose-200"><%= @user.errors.full_messages.to_sentence %></div>
        <% end %>
        <div><%= f.label :name, "Name", class: "label" %><%= f.text_field :name, placeholder: "Ada", class: "input", autofocus: true %></div>
        <div><%= f.label :email_address, "Email", class: "label" %><%= f.email_field :email_address, required: true, placeholder: "you@example.com", class: "input" %></div>
        <div class="grid grid-cols-2 gap-3">
          <div><%= f.label :password, class: "label" %><%= f.password_field :password, required: true, class: "input", placeholder: "Min 8 chars" %></div>
          <div><%= f.label :password_confirmation, "Confirm", class: "label" %><%= f.password_field :password_confirmation, required: true, class: "input" %></div>
        </div>
        <%= f.submit "Create account →", class: "btn-primary w-full cursor-pointer !py-3" %>
      <% end %>
    </div>
  </div>
</div>
