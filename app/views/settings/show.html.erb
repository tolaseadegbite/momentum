<% content_for :title, "Settings — Momentum" %>
<div class="max-w-2xl space-y-6">
  <div>
    <h1 class="text-2xl font-bold tracking-tight font-display">Settings</h1>
    <p class="text-sm text-stone-500 mt-1">Make Momentum yours.</p>
  </div>
  <div class="card">
    <%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-4" do |f| %>
      <% if @user.errors.any? %>
        <div class="rounded-xl bg-rose-50 text-rose-700 text-sm p-3 ring-1 ring-rose-200"><%= @user.errors.full_messages.to_sentence %></div>
      <% end %>
      <div class="grid sm:grid-cols-2 gap-4">
        <div><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input", placeholder: "Your name" %></div>
        <div><%= f.label :email_address, "Email", class: "label" %><%= f.email_field :email_address, class: "input" %></div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div><%= f.label :timezone, class: "label" %><%= f.select :timezone, ActiveSupport::TimeZone.all.map { |z| [z.to_s, z.name] }, {}, class: "input" %></div>
        <div><%= f.label :week_start, "Week starts", class: "label" %><%= f.select :week_start, [["Monday", 1], ["Sunday", 0]], {}, class: "input" %></div>
      </div>
      <div data-controller="avatar-preview">
        <%= f.label :avatar, "Avatar", class: "label" %>
        <div class="flex items-center gap-4">
          <div id="avatar_preview" data-avatar-preview-target="preview">
            <%= render "shared/avatar", user: @user, size: :md %>
          </div>
          <div class="min-w-0">
            <%= f.file_field :avatar, accept: "image/png,image/jpeg,image/gif,image/webp",
                  data: { avatar_preview_target: "input", action: "change->avatar-preview#preview" },
                  class: "text-sm text-stone-500 file:mr-3 file:rounded-lg file:border-0 file:bg-[#1B1031] file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-[#FAF7F2] hover:file:bg-[#C4712A] file:cursor-pointer" %>
            <p data-avatar-preview-target="hint" class="hidden text-xs text-[#A34054] mt-1.5"></p>
            <% if @user.avatar.attached? %>
              <p class="text-xs text-stone-400 mt-1.5">Pick a file to preview it here and in the sidebar instantly.</p>
              <%= link_to "Remove avatar", avatar_settings_path, data: { turbo_method: :delete, turbo_confirm: "Remove your avatar?" }, class: "text-xs font-semibold text-[#A34054] hover:text-[#7C2A3A] mt-1 inline-block" %>
            <% end %>
          </div>
        </div>
      </div>
      <%= f.submit "Save settings", class: "btn-primary cursor-pointer" %>
    <% end %>
  </div>
  <div class="card">
    <h2 class="font-bold text-sm mb-2">Danger zone</h2>
    <%= button_to "Sign out everywhere", session_path, method: :delete, class: "btn-secondary text-sm" %>
  </div>
</div>
