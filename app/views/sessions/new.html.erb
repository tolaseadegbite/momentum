<% content_for :title, "Sign in — Momentum" %>
<div class="min-h-screen grid lg:grid-cols-2">
  <div class="hidden lg:flex flex-col justify-between p-12 bg-[#1B1031] text-[#FAF7F2] relative overflow-hidden">
    <div class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-[#C4712A]/20 blur-3xl"></div>
    <div class="absolute -left-20 bottom-0 w-96 h-96 rounded-full bg-black/30 blur-3xl"></div>
    <a href="/" class="relative flex items-center gap-2.5"><span class="w-9 h-9 rounded-xl bg-white/10 grid place-items-center font-extrabold text-[#E8BCB9]">◍</span><span class="font-extrabold text-lg">Momentum</span></a>
    <div class="relative">
      <h1 class="font-display text-4xl font-bold tracking-tight leading-tight">Build habits<br>that stick.</h1>
      <p class="text-[#E8BCB9]/80 mt-4 max-w-sm">Streaks, mood journaling and beautiful stats — all in one calm, fast app. No noise, just momentum.</p>
      <div class="grid grid-cols-3 gap-3 mt-8 max-w-md">
        <div class="rounded-2xl bg-white/5 ring-1 ring-white/10 p-4"><p class="text-2xl">🔥</p><p class="text-sm font-bold mt-1">Streaks</p><p class="text-xs text-[#E8BCB9]/70">Stay consistent</p></div>
        <div class="rounded-2xl bg-white/5 ring-1 ring-white/10 p-4"><p class="text-2xl">💛</p><p class="text-sm font-bold mt-1">Moods</p><p class="text-xs text-[#E8BCB9]/70">Spot patterns</p></div>
        <div class="rounded-2xl bg-white/5 ring-1 ring-white/10 p-4"><p class="text-2xl">📈</p><p class="text-sm font-bold mt-1">Stats</p><p class="text-xs text-[#E8BCB9]/70">See progress</p></div>
      </div>
    </div>
    <p class="relative text-xs text-[#E8BCB9]/60">Built with Rails 8 • Hotwire • Tailwind</p>
  </div>
  <div class="flex items-center justify-center p-6 sm:p-12 bg-white">
    <div class="w-full max-w-md">
      <a href="/" class="lg:hidden flex items-center gap-2 mb-8"><span class="w-8 h-8 rounded-xl bg-[#1B1031] grid place-items-center text-[#E8BCB9] font-bold">◍</span><span class="font-extrabold">Momentum</span></a>
      <h2 class="font-display text-2xl font-bold tracking-tight">Welcome back 👋</h2>
      <p class="text-sm text-stone-500 mt-1">Sign in to continue your streaks. New here? <%= link_to "Create account", new_registration_path, class: "font-bold text-[#A85A1D] hover:text-[#7A3F10]" %></p>
      <%= form_with url: session_url, class: "mt-6 space-y-4" do |f| %>
        <div><%= f.label :email_address, "Email", class: "label" %><%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address], class: "input" %></div>
        <div><%= f.label :password, class: "label" %><%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, class: "input" %></div>
        <%= f.submit "Sign in →", class: "btn-primary w-full cursor-pointer !py-3" %>
        <p class="text-sm text-center"><%= link_to "Forgot password?", new_password_path, class: "font-semibold text-stone-500 hover:text-[#1B1031]" %></p>
      <% end %>
      <div class="mt-6 rounded-2xl bg-[#FAF7F2] p-4 text-xs text-stone-500 ring-1 ring-stone-900/10">
        Demo: run <code class="bg-white px-1 rounded">bin/rails db:seed</code> then sign in with <strong>demo@momentum.dev / password123</strong>
      </div>
    </div>
  </div>
</div>
