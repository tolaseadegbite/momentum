<% flash.each do |type, msg| %>
  <% color = type.to_s == "notice" ? "bg-[#1B1031] text-[#FAF7F2]" : "bg-[#A34054] text-white" %>
  <div data-controller="toast" class="fixed top-4 right-4 z-[100] flex items-center gap-3 <%= color %> pl-4 pr-3 py-3 rounded-2xl shadow-xl transition-all duration-300 max-w-sm">
    <p class="text-sm font-medium"><%= msg %></p>
    <button data-action="click->toast#dismiss" class="opacity-60 hover:opacity-100 p-1">✕</button>
  </div>
<% end %>
