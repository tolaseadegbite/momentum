    <p class="text-xs text-[#E8BCB9] mt-1">You’re building something great, one day at a time.</p>
  </div>
  <div class="flex items-center gap-3 px-2">
    <span id="sidebar_avatar" class="contents">
      <%= render "shared/avatar", user: Current.user, size: :sm %>
