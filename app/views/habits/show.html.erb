<div class="space-y-6">
  <div>
    <%= link_to "← Back", dashboard_path, class: "text-sm font-semibold text-stone-500 hover:text-[#1B1031]" %>
    <div class="card mt-3 !p-6 relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-1.5 <%= habit_color(@habit, :bar) %>"></div>
      <div class="flex flex-col sm:flex-row sm:items-start gap-4">
        <span class="w-14 h-14 rounded-2xl grid place-items-center <%= habit_color(@habit, :badge) %>"><%= habit_icon_svg(@habit.icon, "w-7 h-7") %></span>
        <div class="flex-1">
          <h1 class="text-2xl font-bold tracking-tight font-display"><%= @habit.title %></h1>
          <p class="text-stone-500 text-sm mt-1"><%= @habit.description.presence || "No description" %></p>
          <div class="flex flex-wrap gap-2 mt-3">
            <%= streak_badge(@habit.streak) %>
            <span class="text-xs font-semibold bg-stone-900/5 px-2 py-1 rounded-full"><%= @habit.frequency %></span>
            <span class="text-xs font-semibold bg-stone-900/5 px-2 py-1 rounded-full"><%= @rate30 %>% / 30 days</span>
          </div>
        </div>
        <div class="flex gap-2">
          <%= link_to "Edit", edit_habit_path(@habit), data: { turbo_frame: "modal" }, class: "btn-secondary !py-2" %>
          <%= button_to "Archive", archive_habit_path(@habit), method: :patch, class: "btn-ghost ring-1 ring-stone-900/10 rounded-xl", form: { data: { turbo_confirm: "Archive this habit?" } } %>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3 mt-6">
        <div class="rounded-xl bg-[#FAF7F2] p-4 text-center ring-1 ring-stone-900/10"><p class="text-2xl font-extrabold font-display"><%= @streak %></p><p class="text-xs text-stone-500 font-medium">Current streak</p></div>
        <div class="rounded-xl bg-[#FAF7F2] p-4 text-center ring-1 ring-stone-900/10"><p class="text-2xl font-extrabold font-display"><%= @longest %></p><p class="text-xs text-stone-500 font-medium">Longest</p></div>
        <div class="rounded-xl bg-[#FAF7F2] p-4 text-center ring-1 ring-stone-900/10"><p class="text-2xl font-extrabold font-display"><%= @rate30 %>%</p><p class="text-xs text-stone-500 font-medium">30-day rate</p></div>
      </div>
    </div>
  </div>

  <div class="card">
    <h2 class="font-bold mb-4">Last 90 days</h2>
    <div class="flex flex-wrap gap-1.5">
      <% @heatmap_days.each do |d| %>
        <% done = @checkin_dates.include?(d) %>
        <span title="<%= d.strftime('%b %-d') %> — <%= done ? 'done ✓' : 'missed' %>"
          class="w-4 h-4 rounded-[5px] <%= done ? 'bg-[#C4712A]' : 'bg-stone-900/10' %> <%= 'ring-2 ring-[#1B1031]' if d == Date.current %>"></span>
      <% end %>
    </div>
    <div class="flex items-center gap-2 mt-3 text-xs text-stone-400">
      <span>Less</span>
      <span class="w-3 h-3 rounded bg-stone-900/10"></span>
      <span class="w-3 h-3 rounded bg-[#F0D3A8]"></span>
      <span class="w-3 h-3 rounded bg-[#C4712A]"></span>
      <span class="w-3 h-3 rounded bg-[#1B1031]"></span>
      <span>More</span>
    </div>
  </div>

  <div class="card">
    <h2 class="font-bold mb-3">Recent check-ins</h2>
    <% if @checkins.any? %>
      <div class="divide-y divide-stone-900/5">
        <% @checkins.each do |c| %>
          <div class="py-2.5 flex items-center gap-3 text-sm">
            <span class="w-8 h-8 rounded-lg bg-[#E2E8DF] text-[#37402F] grid place-items-center font-bold">✓</span>
            <span class="font-semibold"><%= c.occurred_on.strftime("%a, %b %-d") %></span>
            <% if c.note.present? %><span class="text-stone-500 truncate">— <%= c.note %></span><% end %>
            <%= button_to "Remove", habit_checkin_path(@habit, c), method: :delete, class: "ml-auto text-xs text-stone-400 hover:text-[#A34054]", form: { data: { turbo_confirm: "Remove this check-in?" } } %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-stone-500">No check-ins yet. Today’s a great day to start.</p>
    <% end %>
  </div>
</div>
