<div id="<%= dom_id(habit) %>" class="card !p-4 flex gap-4 items-start hover:shadow-md transition group">
  <span class="w-11 h-11 rounded-xl grid place-items-center shrink-0 <%= habit_color(habit, :badge) %>">
    <%= habit_icon_svg(habit.icon) %>
  </span>
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <%= link_to habit.title, habit_path(habit), class: "font-bold tracking-tight hover:text-[#A85A1D] truncate block" %>
        <div class="flex items-center gap-2 mt-1 flex-wrap">
          <%= streak_badge(habit.streak) %>
          <span class="text-xs text-stone-400"><%= habit.frequency %> • <%= habit.completion_rate(days: 30) %>% / 30d</span>
        </div>
      </div>
      <% if checked %>
        <%= button_to uncheck_habit_path(habit, date: date), method: :delete,
          class: "shrink-0 inline-flex items-center gap-1.5 rounded-xl bg-[#5F6C5D] text-white px-3.5 py-2 text-sm font-bold shadow-sm hover:bg-[#4A5546] transition active:scale-95" do %>
          ✓ Done
        <% end %>
      <% else %>
        <%= button_to checkin_habit_path(habit, date: date), method: :post,
          class: "shrink-0 inline-flex items-center gap-1.5 rounded-xl bg-[#1B1031] text-[#FAF7F2] px-3.5 py-2 text-sm font-bold shadow hover:bg-[#C4712A] transition active:scale-95" do %>
          Check in
        <% end %>
      <% end %>
    </div>
    <div class="flex items-center gap-1.5 mt-3">
      <% week_days.each do |d| %>
        <% done = habit.completed_on?(d) %>
        <% is_today = d == date %>
        <span title="<%= d.strftime('%a %b %-d') %>"
          class="w-7 h-7 rounded-lg grid place-items-center text-[11px] font-bold
          <%= done ? 'bg-[#C4712A] text-white' : 'bg-stone-900/5 text-stone-400' %>
          <%= 'ring-2 ring-[#1B1031] ring-offset-1 ring-offset-white' if is_today %>">
          <%= d.strftime("%a").first %>
        </span>
      <% end %>
      <span class="text-xs text-stone-400 ml-1"><%= week_days.first.strftime("%a") %>–<%= week_days.last.strftime("%a") %></span>
    </div>
  </div>
</div>
